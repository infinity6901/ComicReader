<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_reader_settings"
            android:textAppearance="@style/TextAppearance.ComicReader.ItemTitle"
            android:textSize="17sp" />

        <!-- Page mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/menu_page_mode"
            android:textAppearance="@style/TextAppearance.ComicReader.Label"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_page_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_paged"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_mode_paged"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_vertical"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_mode_vertical"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_longstrip"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_mode_longstrip"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Fit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/menu_fit"
            android:textAppearance="@style/TextAppearance.ComicReader.Label"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sheet_fit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fit_screen"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_fit_screen" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fit_width"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_fit_width" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fit_height"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_fit_height" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fit_stretch"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_fit_stretch" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Filter -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/menu_filters"
            android:textAppearance="@style/TextAppearance.ComicReader.Label"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sheet_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_none"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_none" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_invert"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_invert" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_grayscale"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_grayscale" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_contrast"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_contrast" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Reading direction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/menu_reading_dir"
            android:textAppearance="@style/TextAppearance.ComicReader.Label"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sheet_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_dir_ltr"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reading_ltr" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_dir_rtl"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reading_rtl" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Brightness -->
        <TextView
            android:id="@+id/sheet_brightness_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/menu_brightness"
            android:textAppearance="@style/TextAppearance.ComicReader.Label"
            android:textColor="?attr/colorPrimary"
            tools:text="Brightness · 100%" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sheet_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:value="100"
            android:valueFrom="20"
            android:valueTo="100" />

        <!-- Page spacing -->
        <TextView
            android:id="@+id/sheet_spacing_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/menu_page_spacing"
            android:textAppearance="@style/TextAppearance.ComicReader.Label"
            android:textColor="?attr/colorPrimary"
            tools:text="Page spacing · 0 dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sheet_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="48" />

        <!-- Switches -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_two_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:minHeight="48dp"
            android:text="@string/menu_two_page" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_night"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_night" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_keep_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_keep_on" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_more_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/settings" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
