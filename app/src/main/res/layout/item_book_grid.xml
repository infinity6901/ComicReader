<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ComicReader.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_1"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="?attr/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/grid_thumb_h"
            android:background="@drawable/bg_cover_placeholder">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Shape.ComicReader.Cover" />

            <ImageView
                android:id="@+id/placeholder"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textColor="@android:color/white"
                android:textSize="9.5sp"
                android:visibility="gone"
                tools:text="12/40"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/star"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_scrim_circle"
                android:contentDescription="@string/menu_favorites"
                android:padding="4dp"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="@color/star_active"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.ComicReader.ItemTitle"
            android:textSize="13.5sp"
            tools:text="One Piece - Chapter 1044" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.ComicReader.ItemSubtitle"
            android:textSize="11.5sp"
            tools:text="42.1 MB · 24 pages" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
