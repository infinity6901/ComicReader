<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:padding="3dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumb_image"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_thumb_placeholder"
        android:contentDescription="@string/pages_title"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Shape.ComicReader.Thumb"
        app:strokeWidth="0dp" />

    <TextView
        android:id="@+id/thumb_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="5dp"
        android:background="@drawable/bg_scrim_circle"
        android:minWidth="22dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        tools:text="12" />

</FrameLayout>
