<?xml version="1.0" encoding="utf-8"?>
<!--
  The library's overflow menu. Browsing and housekeeping actions stay at the top
  level; the presentation knobs (sort, columns, hidden files) and the bulk tools
  live in two submenus so the list never needs a scroll.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/menu_search"
        android:icon="@drawable/ic_search"
        android:title="@string/menu_search"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="ifRoom|collapseActionView" />

    <item
        android:id="@+id/menu_grid"
        android:title="@string/menu_grid"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_continue"
        android:title="@string/menu_continue"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_new_folder"
        android:title="@string/menu_new_folder"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_add_favorite"
        android:title="@string/menu_add_favorite"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_refresh"
        android:title="@string/menu_refresh"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_view"
        android:title="@string/menu_group_view"
        app:showAsAction="never">
        <menu>
            <item
                android:id="@+id/menu_sort"
                android:title="@string/menu_sort" />
            <item
                android:id="@+id/menu_sort_dir"
                android:title="@string/pref_sort_dir" />
            <item
                android:id="@+id/menu_columns"
                android:title="@string/menu_columns" />
            <item
                android:id="@+id/menu_show_hidden"
                android:checkable="true"
                android:title="@string/menu_show_hidden" />
        </menu>
    </item>

    <item
        android:id="@+id/menu_tools"
        android:title="@string/menu_group_tools"
        app:showAsAction="never">
        <menu>
            <item
                android:id="@+id/menu_search_deep"
                android:checkable="true"
                android:title="@string/menu_search_deep" />
            <item
                android:id="@+id/menu_mark_all_read"
                android:title="@string/menu_mark_all_read" />
            <item
                android:id="@+id/menu_mark_all_unread"
                android:title="@string/menu_mark_all_unread" />
            <item
                android:id="@+id/menu_dupes"
                android:title="@string/menu_dupes" />
            <item
                android:id="@+id/menu_large"
                android:title="@string/menu_large" />
            <item
                android:id="@+id/menu_stats"
                android:title="@string/menu_stats" />
        </menu>
    </item>

    <item
        android:id="@+id/menu_settings"
        android:title="@string/menu_settings"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_about"
        android:title="@string/menu_about"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_exit"
        android:title="@string/menu_exit"
        app:showAsAction="never" />

</menu>
