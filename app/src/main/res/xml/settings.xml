<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_general">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:key="pref_theme"
            app:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/locale_entries"
            app:entryValues="@array/locale_values"
            app:key="pref_locale"
            app:title="@string/pref_language"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="UTF-8"
            app:entries="@array/charset_entries"
            app:entryValues="@array/charset_values"
            app:key="pref_charset"
            app:title="@string/pref_charset"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_appearance">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_show_filenames"
            app:title="@string/pref_show_filenames" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_pathview"
            app:title="@string/pref_list_pathview" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_statusbar"
            app:title="@string/pref_list_statusbar" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_quickfab"
            app:title="@string/pref_list_quickfab" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_reader">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_fullscreen"
            app:title="@string/pref_fullscreen" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_keep_screen_on"
            app:title="@string/pref_keep_on" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_resume"
            app:title="@string/pref_resume" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_ask_resume"
            app:summary="@string/pref_ask_resume_desc"
            app:title="@string/pref_ask_resume" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_auto_next"
            app:summary="@string/pref_auto_next_desc"
            app:title="@string/pref_auto_next" />
        <ListPreference
            app:defaultValue="ltr"
            app:entries="@array/reading_dir_entries"
            app:entryValues="@array/reading_dir_values"
            app:key="pref_reading_dir"
            app:title="@string/pref_reading_dir"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="paged"
            app:entries="@array/page_mode_entries"
            app:entryValues="@array/page_mode_values"
            app:key="pref_page_mode"
            app:title="@string/pref_page_mode"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="screen"
            app:entries="@array/fit_entries"
            app:entryValues="@array/fit_values"
            app:key="pref_fit"
            app:title="@string/pref_fit"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="none"
            app:entries="@array/filter_entries"
            app:entryValues="@array/filter_values"
            app:key="pref_filter"
            app:title="@string/pref_filter"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="100"
            app:key="pref_brightness"
            app:min="20"
            app:showSeekBarValue="true"
            app:title="@string/pref_brightness" />
        <SeekBarPreference
            android:max="48"
            app:defaultValue="0"
            app:key="pref_page_spacing"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/pref_page_spacing" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_two_page"
            app:title="@string/pref_two_page" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_auto_crop"
            app:summary="@string/pref_auto_crop_desc"
            app:title="@string/menu_auto_crop" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_per_series"
            app:summary="@string/pref_per_series_desc"
            app:title="@string/pref_per_series" />
        <ListPreference
            app:defaultValue="2"
            app:entries="@array/preload_entries"
            app:entryValues="@array/preload_values"
            app:key="pref_preload"
            app:title="@string/pref_preload"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="10"
            app:defaultValue="5"
            app:key="pref_auto_speed"
            app:min="1"
            app:showSeekBarValue="true"
            app:title="@string/pref_auto_speed" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_gestures">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_tap_zones"
            app:summary="@string/pref_tap_zones_desc"
            app:title="@string/pref_tap_zones" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_volume_keys"
            app:title="@string/pref_volume_keys" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_brightness_gesture"
            app:title="@string/pref_brightness_gesture" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_double_tap"
            app:title="@string/pref_double_tap" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_chop_exit"
            app:summary="@string/pref_chop_exit_desc"
            app:title="@string/pref_chop_exit" />
        <SeekBarPreference
            android:max="10"
            app:defaultValue="5"
            app:dependency="pref_chop_exit"
            app:key="pref_chop_sensitivity"
            app:min="1"
            app:showSeekBarValue="true"
            app:summary="@string/pref_chop_sensitivity_desc"
            app:title="@string/pref_chop_sensitivity" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_list">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_show_hidden"
            app:title="@string/pref_show_hidden" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_thumbs"
            app:title="@string/pref_thumbs" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_grid"
            app:title="@string/pref_grid" />
        <ListPreference
            app:defaultValue="0"
            app:entries="@array/columns_entries"
            app:entryValues="@array/columns_values"
            app:key="pref_grid_columns"
            app:title="@string/pref_grid_columns"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="name"
            app:entries="@array/sort_entries"
            app:entryValues="@array/sort_values"
            app:key="pref_sort"
            app:title="@string/pref_sort"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="asc"
            app:entries="@array/sort_dir_entries"
            app:entryValues="@array/sort_dir_values"
            app:key="pref_sort_dir"
            app:title="@string/pref_sort_dir"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_data">
        <Preference
            app:key="pref_stats"
            app:title="@string/menu_stats" />
        <Preference
            app:key="pref_backup"
            app:summary="@string/pref_backup_desc"
            app:title="@string/pref_backup" />
        <Preference
            app:key="pref_restore"
            app:summary="@string/pref_restore_desc"
            app:title="@string/pref_restore" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_cache">
        <Preference
            app:key="pref_clear_thumbs"
            app:title="@string/pref_clear_thumbs" />
        <Preference
            app:key="pref_clear_history"
            app:title="@string/pref_clear_history" />
        <Preference
            app:key="pref_clear_bookmarks"
            app:title="@string/pref_clear_bookmarks" />
        <Preference
            app:key="pref_reset"
            app:title="@string/pref_reset" />
    </PreferenceCategory>

</PreferenceScreen>
